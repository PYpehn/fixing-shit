-- Add a safe LoadAutoloadConfig implementation and guarded call to avoid runtime errors
if type(Luna) ~= "table" then
	Luna = {}
end

if type(Luna.LoadAutoloadConfig) ~= "function" then
	function Luna.LoadAutoloadConfig(self, ...)
		local ok, err = pcall(function()
			-- If an autoload ModuleScript is configured, try to require it and call its loader
			if self.Options and self.Options.AutoloadModule then
				local modRef = self.Options.AutoloadModule
				-- If modRef is an Instance (ModuleScript), attempt to require it
				if typeof(modRef) == "Instance" then
					local okReq, ret = pcall(require, modRef)
					if okReq and type(ret) == "table" and type(ret.LoadAutoloadConfig) == "function" then
						-- call module's loader safely
						pcall(function() ret:LoadAutoloadConfig(...) end)
					end
				end
			end
			-- Insert project-specific autoload logic here if needed
		end)
		if not ok then
			warn("Luna.LoadAutoloadConfig failed:", err)
		end
	end
end

-- Guarded call: safe to call even if method later removed or errors
if type(Luna.LoadAutoloadConfig) == "function" then
	local ok, err = pcall(function() Luna:LoadAutoloadConfig() end)
	if not ok then warn("Error while running Luna:LoadAutoloadConfig():", err) end
else
	warn("Luna.LoadAutoloadConfig is not defined; skipping autoload.")
end

-- Return Luna so requiring this file still works if expected
return Luna
